<!--
  CTCP · ai-capacity.xml — exclusion is just containment

  NO conflict edges. NO resource declarations. NO new concept.

  "Aynı anda yapamayacağın işlerin listesi" is a container. Its interior is
  the list. Two occupants of one container's cascade wanting overlapping
  time positions IS the conflict — nothing else needed.

  Toilet blocks coding but not phone use, because they are contents of
  different containers. That is the entire mechanism.
-->
<ctcp-example name="capacity">

    <!--
  ========== the two capacity containers ==========
  Ordinal projections. No time here — these say WHAT competes, not WHEN.
-->

    <projection space="work-capacity">
        <container id="work-capacity" name="Bir şey üstünde çalışmaya uygunluğu">
            <cascade>
                <container id="sleep" name="Uyku" slot="1" />
                <container id="eat" name="Yemek" slot="2" />
                <container id="toilet" name="Tuvalet" slot="3" />
                <container id="write-code-ctcp" name="CTCP kodu" slot="4" />
                <container id="tidy-house" name="Evi Topla" slot="5" time="floating" />
            </cascade>
        </container>
    </projection>

    <projection space="phone-capacity">
        <container id="phone-capacity" name="Telefon kullanma">
            <cascade>
                <container id="sleep" name="Uyku" slot="1" />
                <container id="check-messages" name="Mesajlara bak" slot="2" time="floating" />
                <!--
          toilet is NOT here. fiziksel olarak imkanlı.
          One membership difference produces the whole rule.
        -->
            </cascade>
        </container>
    </projection>


    <!--
  ========== what the engine reads to auto-place ==========
  work-capacity's occupants, projected onto time. The gaps are the answer.
-->
    <projection space="time" window="2026/08/27">
        <container id="time" name="Time">
            <cascade>
                <container kind="gregorian-year" key="2026">
                    <cascade>
                        <container kind="gregorian-month" key="8">
                            <cascade>
                                <container kind="gregorian-day" key="27">
                                    <cascade>

                                        <container kind="utc-hour" key="2">
                                            <cascade>
                                                <container kind="utc-minute" key="0">
                                                    <container id="sleep" name="Uyku" point="start" />
                                                </container>
                                            </cascade>
                                        </container>
                                        <!-- ... -->

                                        <container kind="utc-hour" key="10">
                                            <cascade>
                                                <container kind="utc-minute" key="0">
                                                    <container id="sleep" name="Uyku" point="end" />
                                                    <!-- solved, not authored. the engine put it
                                                    here. -->
                                                    <container id="tidy-house" name="Evi Topla"
                                                        point="start" solved="true" />
                                                </container>
                                                <!-- ... -->
                                                <container kind="utc-minute" key="45">
                                                    <container id="tidy-house" name="Evi Topla"
                                                        point="end" solved="true" />
                                                </container>
                                            </cascade>
                                        </container>
                                        <!-- ... -->

                                        <container kind="utc-hour" key="13">
                                            <cascade>
                                                <container kind="utc-minute" key="0">
                                                    <container id="eat" name="Yemek" point="start" />
                                                </container>
                                                <!-- ... -->
                                                <container kind="utc-minute" key="30">
                                                    <container id="eat" name="Yemek" point="end" />
                                                </container>
                                            </cascade>
                                        </container>
                                        <!-- ... -->

                                        <!--
              work-capacity occupants, projected onto time:
                02:00 .. 10:00   sleep
                13:00 .. 13:30   eat

              GAPS the engine can see:
                10:00 .. 13:00   180 min   <- tidy-house fits, lands here
                13:30 .. 02:00   long
              "en kötü nereye, tüm işinin gücünün sonuna"

              write-code-ctcp and toilet have no time placement yet. They
              compete for the same gaps the moment they get one.
            -->

                                    </cascade>
                                </container>
                            </cascade>
                        </container>
                    </cascade>
                </container>
            </cascade>
        </container>
    </projection>


    <store>

        <container id="work-capacity" name="Bir şey üstünde çalışmaya uygunluğu">
            <children>sleep eat toilet write-code-ctcp tidy-house</children>
        </container>

        <container id="phone-capacity" name="Telefon kullanma">
            <children>sleep check-messages</children>
        </container>

        <!--
      One row, occupying BOTH capacity containers plus time.
      Sleeping blocks work AND phone. Shitting blocks only work.
    -->
        <container id="sleep" name="Uyku">
            <at space="work-capacity" start="slot/1" end="slot/1" />
            <at space="phone-capacity" start="slot/1" end="slot/1" />
            <!--
          PATTERN, not anchored. `*` means ALL, not UNKNOWN.
          That is the opposite quantifier to Partial<T>, which is why it is
          its own form and not a half-filled path.

          This is also why CTCP never implements RFC 5545. Recurrence is a
          wildcard inside a coordinate, not a rule language bolted alongside.
        -->
            <pattern space="time"
                start="gregorian-year/*/gregorian-month/*/gregorian-day/*/utc-hour/02/utc-minute/00"
                end="gregorian-year/*/gregorian-month/*/gregorian-day/*/utc-hour/10/utc-minute/00" />
        </container>

        <container id="eat" name="Yemek">
            <at space="work-capacity" start="slot/2" end="slot/2" />
            <pattern space="time"
                start="gregorian-year/*/gregorian-month/*/gregorian-day/*/utc-hour/13/utc-minute/00"
                end="gregorian-year/*/gregorian-month/*/gregorian-day/*/utc-hour/13/utc-minute/30" />
        </container>

        <!-- blocks work, not phone. one missing membership, whole rule. -->
        <container id="toilet" name="Tuvalet">
            <at space="work-capacity" start="slot/3" end="slot/3" />
        </container>

        <container id="write-code-ctcp" name="CTCP kodu">
            <at space="work-capacity" start="slot/4" end="slot/4" />
        </container>

        <!--
      "evi topla" — bitişi belli değil, açık uçlu.
      The ADHD fix as data: the engine reads gaps and drops it in.

      min-extent counts a PLUGIN unit. Not "PT45M" — an ISO 8601 duration
      would smuggle a universal time scalar back into a protocol built to
      reject exactly that.
    -->
        <container id="tidy-house" name="Evi Topla">
            <at space="work-capacity" start="slot/5" end="slot/5" />
            <floating space="time" op="first-gap" in="work-capacity" after="now">
                <min-extent kind="utc-minute" count="45" />
            </floating>
        </container>

        <!--
      Solved against phone-capacity, so a toilet block does not exclude it.
      "mesajlarını okuma saatini bu sistem sayesinde otomatik saptayabilirsin"
    -->
        <container id="check-messages" name="Mesajlara bak">
            <at space="phone-capacity" start="slot/2" end="slot/2" />
            <floating space="time" op="first-gap" in="phone-capacity" after="now">
                <min-extent kind="utc-minute" count="10" />
            </floating>
        </container>

        <!--
      RECURRENCE WITH A FORMULA. expr is OPAQUE to the engine — the gregorian
      plugin parses it. "her 2 yılda bir", "her 0 ile biten yılda bir".
      The escape hatch that keeps calendar maths out of the core.
    -->
        <container id="ulus-genel-kurul" name="Ulus Genel Kurul">
            <pattern space="time"
                start="gregorian-year/{year % 2 == 0}/gregorian-month/08/gregorian-day/26/utc-hour/14/utc-minute/00"
                end="gregorian-year/{year % 2 == 0}/gregorian-month/08/gregorian-day/26/utc-hour/18/utc-minute/00" />
        </container>

    </store>

</ctcp-example>