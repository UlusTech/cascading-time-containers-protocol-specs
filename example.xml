<cascade owner="null" members="s1, s12">
    <container path="s1" id="gregorian-time">
        <cascade owner="s1" members="s2">
            <!-- ... -->
            <container path="s2" id="gregorian, year, 2026">
                <cascade owner="s2" members="s3">
                    <!-- ... -->
                    <container path="s3" id="gregorian, month, 09">
                        <cascade owner="s3" members="s4">
                            <!-- ... -->
                            <container path="s4" id="gregorian, day, 07">
                                <cascade owner="s4" members="s5">
                                    <!-- ... -->
                                    <container path="s5" id="utc, hour, 16">
                                        <cascade owner="s5" members="s6, s7">
                                            <!-- ... -->
                                            <container path="s6" id="utc, minute, 30">
                                                <cascade owner="s6" members="s8">
                                                    <container path="s8" id="dinner-party"
                                                        name="Dinner Party">
                                                        <cascade owner="s8" members="s9, s10, s11">
                                                            <container path="s9" id="entry-talk"
                                                                name="Entry Talk" />
                                                            <container path="s10" id="entry-meal" />
                                                            <!-- Two entry-talks in one party. Same
                                                            container, two occurrences, and only
                                                            this one is renamed. -->
                                                            <container path="s11" id="entry-talk"
                                                                name="Closing Words" />
                                                        </cascade>
                                                    </container>
                                                </cascade>
                                            </container>
                                            <container path="s7" id="utc, minute, 31" />
                                            <!-- ... -->
                                        </cascade>
                                    </container>
                                    <!-- ... -->
                                </cascade>
                            </container>
                            <!-- ... -->
                        </cascade>
                    </container>
                    <!-- ... -->
                </cascade>
            </container>
            <!-- ... -->
        </cascade>
    </container>

    <!-- No time anywhere above it. Shows inside its box, never on a calendar. -->
    <container path="s12" id="shopping-list">
        <cascade owner="s12" members="s13">
            <container path="s13" id="milk" name="1L Milk" />
        </cascade>
    </container>
</cascade>