{
	"$schema": "./node_modules/lefthook/schema.json",
	"assert_lefthook_installed": true,
	"output": ["failure"],
	"pre-commit": {
		"jobs": [
			{
				"name": "biome",
				"glob": [
					"*.ts",
					"*.tsx",
					"*.mts",
					"*.cts",
					"*.js",
					"*.jsx",
					"*.mjs",
					"*.cjs",
					"*.json",
					"*.jsonc",
					"*.css"
				],
				"run": "node_modules/.bin/biome check --no-errors-on-unmatched --files-ignore-unknown=true --reporter=concise {staged_files}",
				"stage_fixed": true,
				"fail_text": "Biome found problems it cannot fix automatically."
			}
		]
	},
	"pre-push": {
		"parallel": true,
		"jobs": [
			{
				"name": "typecheck",
				"glob": [
					"*.ts",
					"*.tsx",
					"*.mts",
					"*.cts",
					"*.js",
					"*.jsx",
					"*.mjs",
					"*.cjs",
					"*.json",
					"bun.lock"
				],
				"run": "bun run typecheck",
				"fail_text": "Push blocked. Type errors."
			},
			{
				"name": "lint",
				"glob": [
					"*.ts",
					"*.tsx",
					"*.mts",
					"*.cts",
					"*.js",
					"*.jsx",
					"*.mjs",
					"*.cjs",
					"*.json",
					"*.jsonc",
					"*.css"
				],
				"run": "bun run lint --reporter=concise",
				"fail_text": "Push blocked. Lint errors."
			},
			{
				"name": "test",
				"glob": [
					"*.ts",
					"*.tsx",
					"*.mts",
					"*.cts",
					"*.js",
					"*.jsx",
					"*.mjs",
					"*.cjs",
					"*.json",
					"*.jsonc",
					"bun.lock"
				],
				"run": "bun run test --pass-with-no-tests -t '#prepush'",
				"fail_text": "Push blocked. A #prepush test is failing."
			}
		]
	}
}
