<!--
  CTCP · ai-example.xml — the calendar view

  Your example.xml, with the design decisions marked on the nodes.

  ATTRIBUTES
    kind= key=   generated by a plugin. NOT in the database.
    id=          a stored row. see <store> at the bottom of this file.
    point=       one stored interval drawn as two tree nodes,
                 because a tree cannot hold an interval, only points.

  Everything above <store> is a projection. The truth is flat.
-->
<ctcp-example name="calendar">

  <projection space="time">

    <!--
      Root. Renamed from gregorian-time: the upper segments are Gregorian,
      utc-hour and below are not. Naming the root after one of them overclaims.
      The handoff mid-path is one plugin's space yielding to another's.
    -->
    <container id="time" name="Time">
      <cascade>
        <container kind="gregorian-year" key="1" />
        <container kind="gregorian-year" key="2" />
        <!-- ... -->
        <container kind="gregorian-year" key="2025" />

        <!-- 2026 is not a row. gregorian-year is ONE row that makes it. -->
        <container kind="gregorian-year" key="2026">
          <cascade>
            <container kind="gregorian-month" key="1" />
            <!-- ... -->
            <container kind="gregorian-month" key="11" />

            <!--
              31 days here, 28 under key="2", 29 in a leap year.
              The generator reads the ancestor path, not a local index.
              This is why capacity cannot be a stored number.
            -->
            <container kind="gregorian-month" key="12">
              <cascade>
                <container kind="gregorian-day" key="1" />
                <!-- ... -->
                <container kind="gregorian-day" key="31">

                  <!-- stored, no time of its own below day level.
                                   depth 3 = "sometime that day". -->
                    <container id="last-day-note" name="Last day of this year" />

                    <cascade>
                      <!-- ... -->
                      <container kind="utc-hour" key="0">
                        <cascade>
                          <container kind="utc-minute" key="0">
                            <container id="year-start-note"
                              name="Starting of last day of this year" />
                          </container>
                          <!-- ... -->
                        </cascade>
                      </container>
                      <!-- ... -->

                      <container kind="utc-hour" key="16">
                        <cascade>
                          <!-- ... -->
                          <container kind="utc-minute" key="30">

                            <!-- marker 1 of 2 for entry talk -->
                            <container id="dinner-entry-talk"
                              name="Entry Talk" point="start" />

                            <container id="dinner-party"
                              name="Büyük Ulus Akşam Yemeği" point="start">
                              <!--
                                                    SPACE SWITCH. This cascade is the
                                                    dinner-party space — ordinal slots,
                                                    no time. Same rendering, different axis.

                                                    size 4 does NOT mean it ends 4 minutes
                                                    later. Ordinal and temporal position are
                                                    independent, authored separately.
                  -->
                            <cascade space="dinner-party">
                              <container id="dinner-entry-talk"
                                name="Entry Talk" slot="1" />
                              <container id="dinner-entry-meal"
                                name="Entry Meal" slot="2"
                                time="inherited" />
                              <container id="dinner-main-meal"
                                name="Meal" slot="3"
                                time="inherited" />
                              <container id="dinner-dessert"
                                name="Dessert" slot="4"
                                time="inherited" />
                            </cascade>
                          </container>
                        </container>
                        <!-- ... -->

                        <!-- marker 2 of 2. same row as minute 30. -->
                        <container kind="utc-minute" key="40">
                          <container id="dinner-entry-talk"
                            name="Entry Talk" point="end" />
                        </container>
                        <!-- ... -->
                      </cascade>
                    </container>
                    <!-- ... -->

                    <container kind="utc-hour" key="18">
                      <cascade>
                        <!-- ... -->
                        <container kind="utc-minute" key="10">
                          <container id="dinner-party"
                            name="Büyük Ulus Akşam Yemeği" point="end" />
                        </container>
                        <!-- ... -->
                      </cascade>
                    </container>
                    <!-- ... -->
                  </cascade>
                </container>
              </cascade>
            </container>
          </cascade>
        </container>
        <!-- ... -->
      </cascade>
    </container>

  </projection>


  <!--
    ==========================================================
    STORE — every row above, flat. This is what the DB holds.

    Path notation is yours:  kind/key/kind/key/...
    It is sugar for [{kind, key}, ...]. `key` is opaque to the engine.

    Count the rows. The entire year 2026 is zero of them.
    ==========================================================
  -->
  <store>

    <!-- root: no <at> at all. nothing contains it. -->
    <container id="time" name="Time" />

    <container id="dinner-party" name="Büyük Ulus Akşam Yemeği">
      <at space="time"
        start="gregorian-year/2026/gregorian-month/12/gregorian-day/31/utc-hour/16/utc-minute/30"
        end="gregorian-year/2026/gregorian-month/12/gregorian-day/31/utc-hour/18/utc-minute/10" />
      <!--
        Reverse index. NON-NORMATIVE: each child's own <at space="dinner-party">
        already says this. Stored only because deriving it means scanning every
        row for a placement naming us.
        Expensive direction: store. Cheap direction (my parents): derive.
        On conflict the child wins.
      -->
      <children>dinner-entry-talk dinner-entry-meal dinner-main-meal dinner-dessert</children>
    </container>

    <!-- ONE row, TWO spaces, THREE appearances in the projection. -->
    <container id="dinner-entry-talk" name="Entry Talk">
      <at space="dinner-party" start="slot/1" end="slot/1" />
      <at space="time"
        start="gregorian-year/2026/gregorian-month/12/gregorian-day/31/utc-hour/16/utc-minute/30"
        end="gregorian-year/2026/gregorian-month/12/gregorian-day/31/utc-hour/16/utc-minute/40" />
    </container>

    <!--
      Ordinally fixed, temporally silent. No <at space="time">.
      Resolving in time walks up to dinner-party and inherits 16:30–18:10.

      ABSENCE is the encoding. There is no tag="inherited" variant — two
      encodings of one fact is a bug generator on a wire protocol.
    -->
    <container id="dinner-entry-meal" name="Entry Meal">
      <at space="dinner-party" start="slot/2" end="slot/2" />
    </container>

    <container id="dinner-main-meal" name="Meal">
      <at space="dinner-party" start="slot/3" end="slot/3" />
    </container>

    <container id="dinner-dessert" name="Dessert">
      <at space="dinner-party" start="slot/4" end="slot/4" />
    </container>

    <!-- depth 3. "sometime on the 31st" without any precision field. -->
    <container id="last-day-note" name="Last day of this year">
      <at space="time"
        start="gregorian-year/2026/gregorian-month/12/gregorian-day/31"
        end="gregorian-year/2026/gregorian-month/12/gregorian-day/31" />
    </container>

    <container id="year-start-note" name="Starting of last day of this year">
      <at space="time"
        start="gregorian-year/2026/gregorian-month/12/gregorian-day/31/utc-hour/0/utc-minute/0"
        end="gregorian-year/2026/gregorian-month/12/gregorian-day/31/utc-hour/0/utc-minute/0" />
    </container>

  </store>

</ctcp-example>