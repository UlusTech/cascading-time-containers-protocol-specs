{
	"name": "ctcp",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"start": "bun run src/main.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
		"lint": "biome check",
		"lint:watch": "biome-watch",
		"format": "biome check --write",
		"check": "bun run typecheck && bun run lint",
		"test": "bun test",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "^1.3.14",
		"@ulus/biome-watch": "github:UlusTech/biome-watch#v0.1.0",
		"lefthook": "^2.1.10",
		"typescript": "^7.0.2"
	}
}
